# Aegis Backend Configuration - Example
# Copy this file to .env and fill in your actual credentials

# --- Database (PostgreSQL / Supabase) ---
DB_HOST=your-project-ref.supabase.co
DB_NAME=postgres
DB_USER=postgres
DB_PASS=your-database-password
DB_PORT=5432

# --- Authentication (JWT) ---
# Generate a long random string for production
JWT_SECRET=your-super-secret-dev-key-change-in-production

# --- Supabase Auth (for Google/OTP) ---
SUPABASE_ANON_KEY=your-supabase-anon-public-key

# --- Email Service (SMTP / GMAIL) ---
# For Gmail: use an App Password, not your login password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your-email@gmail.com
SENDER_PASSWORD=your-app-specific-password
